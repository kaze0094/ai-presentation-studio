{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presentation 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "language": {
          "const": "vi"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "title",
        "language",
        "audience",
        "objective"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "studio-dark"
        },
        "aspectRatio": {
          "const": "16:9"
        }
      },
      "required": [
        "id",
        "aspectRatio"
      ]
    },
    "assets": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dataUrl": {
            "type": "string",
            "maxLength": 5500000,
            "pattern": "^data:image/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$"
          }
        },
        "required": [
          "id",
          "alt",
          "dataUrl"
        ]
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "story": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "keyMessage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "purpose",
              "keyMessage"
            ]
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "subtitle": {
                "type": "string",
                "maxLength": 200
              },
              "eyebrow": {
                "type": "string",
                "maxLength": 100
              },
              "blocks": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "type": {
                      "enum": [
                        "text",
                        "bullets",
                        "cards",
                        "chart",
                        "image"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 5,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "cards": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                          },
                          "body": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 220
                          }
                        },
                        "required": [
                          "title",
                          "body"
                        ]
                      }
                    },
                    "chart": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "categories": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          }
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000000
                          }
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        }
                      },
                      "required": [
                        "categories",
                        "values",
                        "label"
                      ]
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "text"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "text"
                        ],
                        "properties": {
                          "text": {}
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "bullets"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "items"
                        ],
                        "properties": {
                          "items": {}
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "cards"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "cards"
                        ],
                        "properties": {
                          "cards": {}
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "chart"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "chart"
                        ],
                        "properties": {
                          "chart": {}
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "image"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "assetId"
                        ],
                        "properties": {
                          "assetId": {}
                        }
                      }
                    }
                  ]
                }
              },
              "speakerNotes": {
                "type": "string",
                "maxLength": 5000
              },
              "sources": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            },
            "required": [
              "title",
              "subtitle",
              "eyebrow",
              "blocks",
              "speakerNotes",
              "sources"
            ]
          },
          "design": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layout": {
                "enum": [
                  "hero",
                  "content",
                  "closing"
                ]
              },
              "effect": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "enum": [
                      "none",
                      "threeui.constellation"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "pptxFallback": {
                    "const": "static-image"
                  }
                },
                "required": [
                  "id",
                  "enabled",
                  "pptxFallback"
                ]
              }
            },
            "required": [
              "layout",
              "effect"
            ]
          }
        },
        "required": [
          "id",
          "story",
          "content",
          "design"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "changes-requested"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "slideId": {
                "type": "string",
                "maxLength": 80
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "resolved": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "slideId",
              "severity",
              "message",
              "resolved"
            ]
          }
        }
      },
      "required": [
        "status",
        "findings"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "approvedRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "contentHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      },
      "required": [
        "status",
        "approvedRevision",
        "contentHash",
        "approvedAt"
      ]
    },
    "history": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "actor": {
            "enum": [
              "user",
              "agent-1",
              "agent-2",
              "agent-3",
              "agent-4"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "revision",
          "actor",
          "action",
          "at"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "metadata",
    "theme",
    "assets",
    "slides",
    "review",
    "approval",
    "history"
  ]
}
